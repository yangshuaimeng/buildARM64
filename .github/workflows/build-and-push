# ============================================================
# build-and-push.yml
# 说明: 在 GitHub 原生 ARM64 运行器上构建 Docker 镜像
#       并推送到 GHCR
# 基础镜像参考: ghcr.io/hrygo/openclaw-devkit:2026.5.22
#
# 优势: 原生 ARM64 运行器，无需 QEMU 模拟，构建更快更稳定
#
# 使用方法:
#   1. 将此文件放到 .github/workflows/ 目录
#   2. 确保仓库根目录有 Dockerfile
#   3. 在仓库 Settings > Actions > General 中
#      勾选 "Read and write permissions"
#   4. 如需推送到其他组织，配置 CR_PAT secret
# ============================================================

name: Native ARM64 Build

on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build-arm:
    # 使用 GitHub 原生 ARM64 运行器
    runs-on: ubuntu-24.04-arm64

    steps:
      # ------------------------- 1. 检出代码 -------------------------
      - name: Checkout
        uses: actions/checkout@v4

      # ------------------ 2. 登录 GitHub Container Registry ------------------
      - name: Login to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # ------------------ 3. 设置 Docker Buildx ------------------
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # ------------------ 4. 生成镜像标签和元数据 ------------------
      - name: Generate image metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ghcr.io/${{ github.repository_owner }}/openclaw-devkit
          tags: |
            type=ref,event=branch
            type=sha,prefix={{branch}}-,format=short
            type=raw,value=latest,enable={{is_default_branch}}

      # ------------------ 5. 构建并推送 ------------------
      # 原生 ARM64 环境，不需要 setup-qemu，也不需要指定 platforms
      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            BASE_IMAGE=ghcr.io/hrygo/openclaw-devkit:2026.5.22
          cache-from: type=gha
          cache-to: type=gha,mode=max
